    "PingFrame": {
      "additionalProperties": false,
      "description": "Server heartbeat, every ``api.ws_ping_seconds``, **regardless of replay\nstate**, so a paused replay never looks like a dead socket (R11).",
      "properties": {
        "ts": {
          "format": "date-time",
          "type": "string"
        },
        "type": {
          "const": "ping",
          "type": "string"
        }
      },
      "required": [
        "ts",
        "type"
      ],
      "title": "PingFrame",
      "type": "object"

    "ServerFrame": {
      "description": "Any frame the server may send to a client.",
      "discriminator": {
        "mapping": {
          "alert": "#/$defs/AlertFrame",
          "config": "#/$defs/ConfigFrame",
          "error": "#/$defs/ErrorFrame",
          "explanation": "#/$defs/ExplanationFrame",
          "hello": "#/$defs/HelloFrame",
          "ping": "#/$defs/PingFrame",
          "replay_state": "#/$defs/ReplayStateFrame",
          "risk": "#/$defs/RiskFrame",
          "snapshot": "#/$defs/SnapshotFrame",
          "telemetry": "#/$defs/TelemetryFrame"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/HelloFrame"
        },
        {
          "$ref": "#/$defs/SnapshotFrame"
        },
        {
          "$ref": "#/$defs/TelemetryFrame"
        },
        {

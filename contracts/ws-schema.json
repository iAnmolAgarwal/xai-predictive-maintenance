          "minimum": 1,
          "type": "integer"
        },
        "plant_id": {
          "enum": [
            "ai4i",
            "ims"
          ],
          "type": "string"
        },
        "playing": {
          "type": "boolean"
        },
        "rows_published": {
          "minimum": 0,
          "type": "integer"

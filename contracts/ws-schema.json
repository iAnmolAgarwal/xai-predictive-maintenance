    "RiskFrame": {
      "additionalProperties": false,
      "description": "Batched risk updates.\n\nThere is deliberately **no** frame-level ``dataset_ts``: each update carries\nits own, and the store's dataset clock is advanced from those.",
      "properties": {
        "plant_id": {
          "enum": [
            "ai4i",
            "ims"
          ],
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "type": "string"
        },
        "type": {
          "const": "risk",
          "type": "string"

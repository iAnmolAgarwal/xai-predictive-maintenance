    "SnapshotFrame": {
      "additionalProperties": false,
      "description": "Always the second frame, and re-sent after any ``seek``.\n\nThe dashboard must be fully populated from ``hello`` + ``snapshot`` alone.",
      "properties": {
        "active_alerts": {
          "items": {
            "$ref": "#/$defs/Alert"
          },
          "type": "array"
        },
        "dataset_ts": {
          "format": "date-time",
          "type": "string"
        },
        "machines": {
          "items": {
            "$ref": "#/$defs/MachineSnapshot"
          },
          "type": "array"
        },
        "plant_id": {
          "enum": [
            "ai4i",
            "ims"
          ],
          "type": "string"
        },
        "replay_state": {
          "$ref": "#/$defs/ReplayState"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{12}$",
          "type": "string"
        },
        "type": {
          "const": "snapshot",
          "type": "string"
        }
      },
      "required": [
        "plant_id",
        "run_id",
        "dataset_ts",
        "machines",
        "active_alerts",
        "replay_state",
        "type"

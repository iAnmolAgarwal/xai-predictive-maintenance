{
  "$defs": {
    "Alert": {
      "additionalProperties": false,
      "description": "An opened alert (backend.md §3.4.2).\n\nDefined here rather than in :mod:`xpm.contracts.rest` because the MQTT\n``AlertMessage`` and the WebSocket ``alert`` frame both extend it, and\n``rest`` imports from ``mqtt``. It is re-exported from both\n:mod:`xpm.contracts.rest` and :mod:`xpm.contracts`.",
      "properties": {
        "alert_id": {
          "pattern": "^alt_[0-9a-f]{16}$",
          "type": "string"
        },
        "closed_dataset_ts": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataset_ts": {
          "format": "date-time",
          "type": "string"
        },
        "explanation_id": {
          "pattern": "^exp_[0-9a-f]{16}$",
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "machine_display_name": {
          "type": "string"
        },
        "machine_id": {
          "pattern": "^(ai4i|ims)-\\d{2}$",
          "type": "string"
        },
        "model_id": {
          "pattern": "^(lgbm|rf)@\\d+\\.\\d+\\.\\d+$",
          "type": "string"
        },
        "plant_id": {
          "enum": [
            "ai4i",
            "ims"
          ],
          "type": "string"
        },
        "probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{12}$",
          "type": "string"
        },
        "severity": {
          "enum": [
            "medium",
            "high",
            "critical"
          ],
          "type": "string"
        },
        "top_feature": {
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "alert_id",
        "run_id",
        "plant_id",
        "machine_id",
        "machine_display_name",
        "dataset_ts",
        "ts",
        "model_id",
        "probability",
        "severity",
        "headline",
        "top_feature",
        "explanation_id",
        "closed_dataset_ts"
      ],
      "title": "Alert",
      "type": "object"
    },
    "AlertFrame": {
      "additionalProperties": false,
      "description": "The REST ``Alert`` model spread into a frame.",
      "properties": {
        "alert_id": {
          "pattern": "^alt_[0-9a-f]{16}$",
          "type": "string"
        },
        "closed_dataset_ts": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataset_ts": {
          "format": "date-time",
          "type": "string"
        },
        "explanation_id": {
          "pattern": "^exp_[0-9a-f]{16}$",
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "machine_display_name": {
          "type": "string"
        },
        "machine_id": {
          "pattern": "^(ai4i|ims)-\\d{2}$",
          "type": "string"
        },
        "model_id": {
          "pattern": "^(lgbm|rf)@\\d+\\.\\d+\\.\\d+$",
          "type": "string"
        },
        "plant_id": {
          "enum": [
            "ai4i",
            "ims"
          ],
          "type": "string"
        },
        "probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{12}$",
          "type": "string"
        },
        "severity": {
          "enum": [
            "medium",
            "high",
            "critical"
          ],
          "type": "string"
        },
        "top_feature": {
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "type": "string"
        },
        "type": {
          "const": "alert",
          "type": "string"
        }
      },
      "required": [
        "alert_id",
        "run_id",
        "plant_id",
        "machine_id",
        "machine_display_name",
        "dataset_ts",
        "ts",
        "model_id",
        "probability",
        "severity",
        "headline",
        "top_feature",
        "explanation_id",
        "closed_dataset_ts",
        "type"
      ],
      "title": "AlertFrame",
      "type": "object"
    },
    "ChannelSpec": {
      "additionalProperties": false,
      "description": "One sensor channel. The 16 rows live in :mod:`xpm.contracts.channels`.",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "nominal_max": {
          "type": "number"
        },
        "nominal_min": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "vibration_like": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "display_name",
        "unit",
        "vibration_like",
        "nominal_min",
        "nominal_max"
      ],
      "title": "ChannelSpec",
      "type": "object"
    },
    "ClientFrame": {
      "additionalProperties": false,
      "description": "Any frame a client may send to the server. `pong` is the only one.",
      "properties": {
        "ts": {
          "format": "date-time",
          "type": "string"
        },
        "type": {
          "const": "pong",
          "type": "string"
        }
      },
      "required": [
        "ts",
        "type"
      ],
      "title": "ClientFrame",
      "type": "object"
    },
    "ConfigFrame": {
      "additionalProperties": false,
      "description": "Pushed after a successful ``PUT /api/config``.",
      "properties": {
        "mutable_keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^run_[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "config",
          "type": "string"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "values",
        "mutable_keys",
        "updated_at",
        "type"
      ],
      "title": "ConfigFrame",
      "type": "object"
    },
    "ErrorFrame": {
      "additionalProperties": false,
      "description": "Protocol or backpressure error.",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "error",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "request_id",
        "type"
      ],
      "title": "ErrorFrame",
      "type": "object"
    },
    "ExplanationFrame": {
      "additionalProperties": false,
      "description": "The REST ``Explanation`` spread into a frame, sent immediately after its\n``alert`` frame and within the same second.",
      "properties": {
        "alert_id": {
          "pattern": "^alt_[0-9a-f]{16}$",
          "type": "string"
        },
        "base_value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "caveat": {
          "type": "string"
        },
        "contributions": {
          "items": {
            "$ref": "#/$defs/ShapContribution"
          },
          "type": "array"
        },
        "dataset_ts": {
          "format": "date-time",
          "type": "string"
        },
        "explanation_id": {
          "pattern": "^exp_[0-9a-f]{16}$",
          "type": "string"
        },
        "machine_id": {
          "pattern": "^(ai4i|ims)-\\d{2}$",
          "type": "string"
        },
        "model_id": {
          "pattern": "^(lgbm|rf)@\\d+\\.\\d+\\.\\d+$",
          "type": "string"
        },
        "model_kind": {
          "enum": [
            "lgbm",
            "rf"
          ],
          "type": "string"
        },
        "n_features": {
          "minimum": 1,
          "type": "integer"
        },
        "other_contributions_count": {
          "minimum": 0,
          "type": "integer"
        },
        "other_contributions_shap": {
          "type": "number"
        },
        "output_value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "sentence": {
          "type": "string"
        },
        "sentence_spans": {
          "items": {
            "$ref": "#/$defs/SentenceSpan"
          },
          "type": "array"
        },
        "shap_space": {
          "const": "probability",
          "type": "string"
        },
        "type": {
          "const": "explanation",
          "type": "string"
        }
      },
      "required": [
        "explanation_id",
        "alert_id",
        "machine_id",
        "model_id",
        "model_kind",
        "shap_space",
        "dataset_ts",
        "base_value",
        "output_value",
        "probability",
        "contributions",
        "other_contributions_shap",
        "other_contributions_count",
        "n_features",
        "sentence",
        "sentence_spans",
        "caveat",
        "type"
      ],
      "title": "ExplanationFrame",
      "type": "object"
    },
    "HelloFrame": {
      "additionalProperties": false,
      "description": "Always the first frame on every connect (R10).",
      "properties": {
        "plant": {
          "$ref": "#/$defs/Plant"
        },
        "protocol_version": {
          "const": 1,
          "type": "integer"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{12}$",
          "type": "string"
        },
        "server_time": {
          "format": "date-time",
          "type": "string"
        },
        "type": {
          "const": "hello",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "server_time",
        "plant",
        "type",
        "protocol_version"
      ],
      "title": "HelloFrame",
      "type": "object"
    },

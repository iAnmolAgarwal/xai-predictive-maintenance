# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.ipynb_checkpoints

# --- Node ---
node_modules/
web/dist/
web/coverage/
web/playwright-report/
web/test-results/
*.tsbuildinfo
.eslintcache

# --- Data & models (R2: raw out, processed in) ---
# Raw archives are never committed (the IMS archive alone is 1.0 GB).
data/raw/**
data/*.csv
data/*.zip
data/*.rar
data/*.7z
data/*.db
data/*.db-*
# Processed build outputs ARE committed so a fresh clone streams both plants
# with zero downloads. They must stay under 5 MB in total.
# These two negations are currently no-ops -- nothing above ignores
# data/processed -- and are kept deliberately (R2) so that tightening the rules
# above to `data/**` cannot silently stop the committed parquet from tracking.
!data/processed/**/*.parquet
!data/processed/**/*.json
# Model artefacts are reproducible from the committed processed data + seed.
models/registry/**
*.pkl
*.joblib
*.onnx
*.h5
# Generated evaluation reports, except the directory marker.
reports/**
!reports/.gitkeep

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Docker / runtime ---
volumes/
*.db-journal
mosquitto/data/
mosquitto/log/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Claude local ---
.claude/settings.local.json
